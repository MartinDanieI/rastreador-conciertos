# Copia este archivo como .env (no se sube a GitHub).
# En GitHub Actions van en Settings > Secrets and variables > Actions > Secrets.

# Token de @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Tu chat_id (python rastreador.py --telegram-chat-id). Varios separados por coma.
TELEGRAM_CHAT_ID=

# Opcionales
# HEARTBEAT_HOUR=8   # hora de Colombia del mensaje diario "sigo activo"
# EVENTOS_FILE=eventos.json
# LOG_LEVEL=INFO
# DRY_RUN=false
